{
    "name": "patterns/result",
    "description": "Result pattern - represent the outcome of operations that might fail, explicitly and without exceptions.",
    "type": "library",
    "keywords": [
        "result",
        "pattern",
        "error-handling",
        "either",
        "railway",
        "functional"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Patterns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Patterns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
